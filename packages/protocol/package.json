{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@xcoder/protocol",
  "version": "2.0.32",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder-ai/coder.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./simulation": "./src/simulation.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "generate": "bun run script/generate-openapi.ts",
    "check:generated": "bun run script/generate-openapi.ts --check",
    "test": "bun test --only-failures",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xcoder/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "prettier": "3.6.2",
    "typescript": "catalog:"
  }
}
