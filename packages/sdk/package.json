{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.0.32",
  "name": "@xcoder/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder-ai/coder.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "tsc -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@xcoder/client": "workspace:*",
    "@xcoder/core": "workspace:*",
    "@xcoder/plugin": "workspace:*",
    "@xcoder/schema": "workspace:*",
    "@xcoder/server": "workspace:*",
    "@xcoder/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@xcoder/ai": "workspace:*",
    "@xcoder/httpapi-codegen": "workspace:*",
    "@xcoder/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
