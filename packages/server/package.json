{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@xcoder/server",
  "version": "2.0.32",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coder-ai/coder.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --only-failures",
    "typecheck": "tsc -b",
    "probe:workerd": "bun run script/workerd-probe.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@xcoder/core": "workspace:*",
    "@xcoder/protocol": "workspace:*",
    "@xcoder/schema": "workspace:*",
    "@xcoder/simulation": "workspace:*",
    "@xcoder/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@opencode-ai/pty": "0.2.0",
    "@xcoder/client": "workspace:*",
    "@xcoder/plugin": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:"
  }
}
