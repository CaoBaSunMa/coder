{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coder-files",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "coder-dev-files",
      "routes": [{ "pattern": "dev.coder.example.com/files/*", "zone_name": "coder.example.com" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "coder-dev-files" }],
    },
    "production": {
      "name": "coder-production-files",
      "routes": [{ "pattern": "coder.example.com/files/*", "zone_name": "coder.example.com" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "coder-production-files" }],
    },
  },
}
